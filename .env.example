# OpsFlow Enterprise SaaS Configuration

# Flask Environment: development, testing, production
FLASK_ENV=development
PORT=5000
SECRET_KEY=generate-a-strong-random-secret-key-for-production

# SQLAlchemy Database URL
# For local SQLite:
DATABASE_URL=sqlite:///opsflow_saas.db
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/opsflow_db

# Security & Sessions
SESSION_COOKIE_SECURE=0
WEBHOOK_TIMEOUT_SECONDS=5

# Optional SMTP Relay for Outbound Email Actions
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_api_key

# Stripe Billing & Subscriptions (Phase 4)
# Keep empty for local development to use default Free tier
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here
# Optional Stripe Price IDs for automated recurring plans
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_placeholder
STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly_placeholder
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_placeholder
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_placeholder
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly_placeholder
STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly_placeholder
